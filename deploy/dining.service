# Keeps the dining tracker running on the VPS.
# systemd starts it at boot and restarts it if it crashes.
[Unit]
Description=Dining hall occupancy tracker
After=network.target

[Service]
User=dining
WorkingDirectory=/opt/dining
# DINING_API_KEY lives here, so the secret isn't in the code
EnvironmentFile=/etc/dining.env
# Only listen on the VPS itself; Caddy handles the outside world (and HTTPS)
ExecStart=/opt/dining/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
